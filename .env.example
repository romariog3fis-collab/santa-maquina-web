# SANTA MÁQUINA — VARIÁVEIS DE AMBIENTE (PRODUÇÃO)
# Adicione estas variáveis no painel da Vercel (Settings -> Environment Variables)
# ou no seu provedor de hospedagem:

# 1. MERCADO PAGO (Obtenha em: https://www.mercadopago.com.br/developers/panel/app)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-aqui
MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-aqui

# 2. ASAAS (Obtenha em: https://www.asaas.com/ -> Configurações -> Integrações -> Chaves de API)
ASAAS_API_KEY=$aact_sua_chave_de_api_asaas_aqui

# 3. NOTIFICAÇÕES WHATSAPP (Opcional - Evolution API / Z-API / WaMe)
WHATSAPP_ADMIN_NUMBER=5585997428530

